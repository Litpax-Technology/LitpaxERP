const SLIP_FOLDER_NAME = 'Payments Screenshots of sales Orders';
const CUST_FOLDER_NAME = 'LitpaxERP_Customer_Docs';

function getCustFolderId() {
  var token = ScriptApp.getOAuthToken();
  var q = encodeURIComponent('name="' + CUST_FOLDER_NAME + '" and mimeType="application/vnd.google-apps.folder" and trashed=false');
  var res   = UrlFetchApp.fetch('https://www.googleapis.com/drive/v3/files?q=' + q + '&fields=files(id)', { headers: { 'Authorization': 'Bearer ' + token } });
  var files = JSON.parse(res.getContentText()).files;
  if (files && files.length > 0) return files[0].id;
  var createRes = UrlFetchApp.fetch('https://www.googleapis.com/drive/v3/files', {
    method: 'POST',
    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
    payload: JSON.stringify({ name: CUST_FOLDER_NAME, mimeType: 'application/vnd.google-apps.folder' })
  });
  return JSON.parse(createRes.getContentText()).id;
}

function uploadCustomerDoc(data) {
  try {
    var token    = ScriptApp.getOAuthToken();
    var custName = (data['customerName'] || 'Unknown').replace(/[^a-zA-Z0-9]/g, '_');
    var fileName = custName + '_' + (data['fileName'] || 'doc');
    var mimeType = data['mimeType'] || 'application/pdf';
    var base64   = data['base64'] || '';
    var folderId = getCustFolderId();
    if (!base64) return { success: false, message: 'No file data' };
    var boundary = 'litpax_cust';
    var meta     = JSON.stringify({ name: fileName, parents: [folderId] });
    var CRLF     = '\r\n';
    var body     = '--' + boundary + CRLF + 'Content-Type: application/json' + CRLF + CRLF + meta + CRLF +
                   '--' + boundary + CRLF + 'Content-Type: ' + mimeType + CRLF + 'Content-Transfer-Encoding: base64' + CRLF + CRLF + base64 + CRLF +
                   '--' + boundary + '--';
    var uploadRes = UrlFetchApp.fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'multipart/related; boundary=' + boundary },
      payload: body
    });
    var fileData = JSON.parse(uploadRes.getContentText());
    UrlFetchApp.fetch('https://www.googleapis.com/drive/v3/files/' + fileData.id + '/permissions', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
      payload: JSON.stringify({ role: 'reader', type: 'anyone' })
    });
    return { success: true, fileId: fileData.id, url: 'https://drive.google.com/file/d/' + fileData.id + '/view', name: fileName };
  } catch(e) {
    return { success: false, message: e.toString() };
  }
}

