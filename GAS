// =============================================
// RECALC CHARGER TOTALS across Order/Production/Accounts
// (charger edit/delete ke baad qty + model + order value theek karo)
// =============================================
function recalcChargerTotals(orderID) {
  try {
    if (!orderID) return;
    var ss = SS_SALES();

    // 1) OrderItemCharger se is order ke saare charger padho
    var cSheet = ss.getSheetByName('OrderItemCharger');
    var totalCQty = 0, chargerTotal = 0, models = [];
    if (cSheet && cSheet.getLastRow() > 1) {
      var cV = cSheet.getDataRange().getValues();
      var cH = cV[0];
      var cO = cH.indexOf('Order ID');
      var cQ = cH.indexOf('Qty');
      var cT = cH.indexOf('Total');
      var cM = cH.indexOf('Charger Model');
      for (var i = 1; i < cV.length; i++) {
        if (cV[i][cO] == orderID) {
          totalCQty    += parseFloat(cV[i][cQ]) || 0;
          chargerTotal += parseFloat(cV[i][cT]) || 0;
          var m = cM >= 0 ? (cV[i][cM] || '') : '';
          if (m && models.indexOf(m) === -1) models.push(m);
        }
      }
    }
    var modelStr = models.join(', ');

    // 2) Orders sheet — Charger Qty set karo, phir pura order value recompute
    var oSheet = ss.getSheetByName('Orders');
    var oV = oSheet.getDataRange().getValues();
    var oH = oV[0];
    var ordIdx   = oH.indexOf('Order ID');
    var chrIdx   = oH.indexOf('Charger Qty');
    var valIdx   = oH.indexOf('Total Order Value');
    var transIdx = oH.indexOf('Transportation Charges');

    var itemSheet = ss.getSheetByName('OrderItems');
    var iV = itemSheet.getDataRange().getValues();
    var iH = iV[0];
    var iO = iH.indexOf('Order ID');
    var iT = iH.indexOf('Total');
    var batteryTotal = 0;
    for (var b = 1; b < iV.length; b++) {
      if (iV[b][iO] == orderID) batteryTotal += parseFloat(iV[b][iT]) || 0;
    }

    for (var r = 1; r < oV.length; r++) {
      if (oV[r][ordIdx] == orderID) {
        var trans = transIdx >= 0 ? (parseFloat(oV[r][transIdx]) || 0) : 0;
        if (chrIdx >= 0) oSheet.getRange(r + 1, chrIdx + 1).setValue(totalCQty);
        if (valIdx >= 0) oSheet.getRange(r + 1, valIdx + 1).setValue(Math.round(batteryTotal * 1.18 + chargerTotal + trans));
        break;
      }
    }

    // 3) Production sheet — Charger Qty + Model
    try {
      var pSheet = SpreadsheetApp.openById(PROD_ID).getSheetByName('Production');
      if (pSheet && pSheet.getLastRow() > 1) {
        var pV = pSheet.getDataRange().getValues();
        var pH = pV[0];
        var pO = pH.indexOf('Order ID');
        var pC = pH.indexOf('Charger Qty');
        var pM = pH.indexOf('Charger Model');
        for (var p = 1; p < pV.length; p++) {
          if (pV[p][pO] == orderID) {
            if (pC >= 0) pSheet.getRange(p + 1, pC + 1).setValue(totalCQty);
            if (pM >= 0) pSheet.getRange(p + 1, pM + 1).setValue(modelStr);
            break;
          }
        }
      }
    } catch(pe) { Logger.log('recalc prod charger error: ' + pe); }

    // 4) Accounts sheet — Charger Qty + Model
    try {
      var aSheet = SS_ACC().getSheetByName('Accounts');
      if (aSheet && aSheet.getLastRow() > 1) {
        var aV = aSheet.getDataRange().getValues();
        var aH = aV[0];
        var aO = aH.indexOf('Order ID');
        var aC = aH.indexOf('Charger Qty');
        var aM = aH.indexOf('Charger Model');
        for (var a = 1; a < aV.length; a++) {
          if (aV[a][aO] == orderID) {
            if (aC >= 0) aSheet.getRange(a + 1, aC + 1).setValue(totalCQty);
            if (aM >= 0) aSheet.getRange(a + 1, aM + 1).setValue(modelStr);
          }
        }
      }
    } catch(ae) { Logger.log('recalc acc charger error: ' + ae); }

  } catch(e) {
    Logger.log('recalcChargerTotals ERROR: ' + e.toString());
  }
}

