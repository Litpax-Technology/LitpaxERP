          name:      vals[i][nIdx],
          role:      vals[i][rIdx],
          salesName: sIdx >= 0 ? String(vals[i][sIdx] || '') : ''
        }
      };
    }
  }
  return { success: false, message: 'Invalid username or password' };
}

// =============================================
// ADD ORDER
// =============================================

function addOrder(data) {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const ss    = SS_SALES();
    const sheet = ss.getSheetByName('Orders');
    if (!sheet) return { success: false, message: 'Orders tab not found' };

    SpreadsheetApp.flush();

    // --- Order ID: max existing number + 1 (row position pe depend NAHI) ---
    const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    const idIdx   = headers.indexOf('Order ID');
    let maxNum = 0;
    if (idIdx >= 0 && sheet.getLastRow() > 1) {
      const idVals = sheet.getRange(2, idIdx + 1, sheet.getLastRow() - 1, 1).getValues();
      for (let i = 0; i < idVals.length; i++) {
        const m = String(idVals[i][0]).match(/ORD-(\d+)/);
        if (m) {
          const n = parseInt(m[1], 10);
          if (n > maxNum) maxNum = n;
        }
      }
    }
    const orderID = 'ORD-' + String(maxNum + 1).padStart(4, '0');
    data['Order ID'] = orderID;

    if (data['Date']) {
      data['Date'] = fixDateFormat(data['Date']);
    } else {
      var now = new Date();
      data['Date'] = now.getDate().toString().padStart(2,'0') + '/' +
                     (now.getMonth()+1).toString().padStart(2,'0') + '/' +
                     now.getFullYear();
    }
    const row = headers.map(h => data[h] !== undefined ? data[h] : '');
    sheet.appendRow(row);
    SpreadsheetApp.flush();
    autoSaveCustomerFromOrder(data);
    return { success: true, message: 'Order created', orderID: orderID };
  } finally {
    lock.releaseLock();
  }
}

