// =============================================
// DELETE ORDER (full cascade — Sales/CRM/Production/Accounts/Payments/Billings/Dispatch)
// =============================================

function deleteRowsByOrderId_(ss, sheetName, orderID) {
  var sheet = ss.getSheetByName(sheetName);
  if (!sheet || sheet.getLastRow() <= 1) return 0;
  var vals    = sheet.getDataRange().getValues();
  var headers = vals[0];
  var idCol   = headers.indexOf('Order ID');
  if (idCol < 0) return 0;
  var deleted = 0;
  for (var r = vals.length - 1; r >= 1; r--) {
    if (String(vals[r][idCol]).trim() === String(orderID).trim()) {
      sheet.deleteRow(r + 1);
      deleted++;
    }
  }
  return deleted;
}

function deleteOrder(data) {
  var orderID = data['Order ID'] || '';
  if (!orderID) return { success: false, message: 'Order ID missing' };
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var salesDeleted = deleteRowsByOrderId_(SS_SALES(), 'Orders', orderID);
    if (salesDeleted === 0) return { success: false, message: 'Order not found: ' + orderID };

    deleteRowsByOrderId_(SS_SALES(), 'OrderItems', orderID);
    deleteRowsByOrderId_(SS_SALES(), 'OrderItemCharger', orderID);
    deleteRowsByOrderId_(SS_PROD(),  'Production', orderID);
    deleteRowsByOrderId_(SS_PROD(),  'Planned Production', orderID);
    deleteRowsByOrderId_(SS_ACC(),   'Accounts', orderID);
    deleteRowsByOrderId_(SS_ACC(),   'Billings', orderID);
    deleteRowsByOrderId_(SS_CRM(),   'CRM1', orderID);
    deleteRowsByOrderId_(SS_CRM(),   'Payments', orderID);
    deleteRowsByOrderId_(SS_DISP(),  'Dispatch', orderID);

    return { success: true, message: 'Order ' + orderID + ' deleted from all sheets' };
  } catch(e) {
    return { success: false, message: e.toString() };
  } finally {
    lock.releaseLock();
  }
}

