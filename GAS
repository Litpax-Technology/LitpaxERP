function addDispatch(data) {
  try {
    var lock = LockService.getScriptLock();
    lock.waitLock(30000);
    try {
      var sheet = getDispatchSheet();

      // Dispatch ID — max existing number + 1 (addOrder jaisa pattern)
      var maxNum = 0;
      if (sheet.getLastRow() > 1) {
        var idVals = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues();
        for (var i = 0; i < idVals.length; i++) {
          var m = String(idVals[i][0]).match(/DSP-(\d+)/);
          if (m) { var n = parseInt(m[1], 10); if (n > maxNum) maxNum = n; }
        }
      }
      var dispatchID = 'DSP-' + String(maxNum + 1).padStart(4, '0');

      var date = data['Dispatch Date'] || '';
      if (/^\d{4}-\d{2}-\d{2}/.test(date)) date = fixDateFormat(date);
      if (!date) {
        var now = new Date();
        date = now.getDate().toString().padStart(2,'0') + '/' +
               (now.getMonth()+1).toString().padStart(2,'0') + '/' +
               now.getFullYear();
      }

      sheet.appendRow([
        dispatchID,
        data['Order ID']       || '',
        data['Item ID']        || '',
        parseFloat(data['Dispatch Qty']) || 0,
        date,
        data['Transport Name'] || '',
        data['Vehicle No']     || '',
        data['LR No']          || '',
        data['Driver No']      || '',
        data['Remarks']        || '',
        data['Added By']       || '',
        new Date()
      ]);

      var orderDispatched = false;
      try { orderDispatched = checkOrderFullyDispatched(data['Order ID'] || '', date); } catch(e) { Logger.log('checkOrderFullyDispatched: ' + e); }

      return { success: true, dispatchID: dispatchID, orderDispatched: orderDispatched };
    } finally {
      lock.releaseLock();
    }
  } catch(e) {
    return { success: false, message: e.toString() };
  }
}

