// Saare items fully dispatched? → Order Status "<prefix> - Dispatched" + CRM update
function checkOrderFullyDispatched(orderID, dispDate) {
  if (!orderID) return false;

  // 1. Order ke items ki total qty (OrderItems se)
  var itemSheet = SS_SALES().getSheetByName('OrderItems');
  if (!itemSheet || itemSheet.getLastRow() <= 1) return false;
  var iVals = itemSheet.getDataRange().getValues();
  var iH    = iVals[0];
  var iOIdx = iH.indexOf('Order ID');
  var iIIdx = iH.indexOf('Item ID');
  var iQIdx = -1;
  for (var k = 0; k < iH.length; k++) {
    if (iH[k].toString().trim() === 'Qty') { iQIdx = k; break; }
  }
  var itemQty = {};
  for (var i = 1; i < iVals.length; i++) {
    if (iVals[i][iOIdx] == orderID) {
      itemQty[String(iVals[i][iIIdx]).trim()] = parseFloat(iVals[i][iQIdx]) || 0;
    }
  }
  if (Object.keys(itemQty).length === 0) return false;

  // 2. Ab tak dispatched totals
  var dSheet = getDispatchSheet();
  var dVals  = dSheet.getDataRange().getValues();
  var dH     = dVals[0];
  var dOIdx  = dH.indexOf('Order ID');
  var dIIdx  = dH.indexOf('Item ID');
  var dQIdx  = dH.indexOf('Dispatch Qty');
  var dispatched = {};
  for (var d = 1; d < dVals.length; d++) {
    if (dVals[d][dOIdx] == orderID) {
      var iid = String(dVals[d][dIIdx]).trim();
      dispatched[iid] = (dispatched[iid] || 0) + (parseFloat(dVals[d][dQIdx]) || 0);
    }
  }

  // 3. Har item fully dispatched?
  var allDone = Object.keys(itemQty).every(function(iid) {
    return (dispatched[iid] || 0) >= itemQty[iid];
  });
  if (!allDone) return false;

  // 4. Order Status → "<prefix> - Dispatched"
  var oSheet = SS_SALES().getSheetByName('Orders');
  if (oSheet) {
    var oVals = oSheet.getDataRange().getValues();
    var oH    = oVals[0];
    var oOIdx = oH.indexOf('Order ID');
    var oSIdx = oH.indexOf('Order Status');
    for (var r = 1; r < oVals.length; r++) {
      if (oVals[r][oOIdx] == orderID) {
        var cur = String(oVals[r][oSIdx] || '');
        var pfx = cur.indexOf(' - ') > -1 ? cur.split(' - ')[0] : 'Advance';
        if (oSIdx >= 0) oSheet.getRange(r + 1, oSIdx + 1).setValue(pfx + ' - Dispatched');
        break;
      }
    }
  }

  // 5. CRM — Ready to Dispatch Actual (jahan khaali hai) + Current Stage
  try {
    var crmSheet = SS_CRM().getSheetByName('CRM1');
    if (crmSheet && crmSheet.getLastRow() > 1) {
      var cVals = crmSheet.getDataRange().getValues();
      var cH    = cVals[0];
      var cOIdx = cH.indexOf('Order ID');
      var cRIdx = cH.indexOf('Ready to Dispatch Actual');
      var cSIdx = cH.indexOf('Current Stage');
      for (var c = 1; c < cVals.length; c++) {
        if (cVals[c][cOIdx] == orderID) {
          if (cRIdx >= 0 && !cVals[c][cRIdx]) crmSheet.getRange(c + 1, cRIdx + 1).setValue(dispDate);
          if (cSIdx >= 0) crmSheet.getRange(c + 1, cSIdx + 1).setValue('Dispatched');
        }
      }
    }
  } catch(ce) { Logger.log('CRM dispatch update error: ' + ce); }

  return true;
}

// =============================================
// SYNC: ITEM EDIT → Production + Accounts + CRM1 (Item ID match)
// =============================================
function syncItemToLinkedSheets(data) {
  var itemID = String(data['Item ID'] || '').trim();
  if (!itemID) return;
  var syncFields = ['Product Model', 'Battery Type', 'Qty'];

  function syncSheet(sheet) {
    if (!sheet || sheet.getLastRow() <= 1) return;
    var vals    = sheet.getDataRange().getValues();
    var headers = vals[0].map(function(h) { return h.toString().trim(); });
    var iIdx    = headers.indexOf('Item ID');
    if (iIdx < 0) return;
    for (var r = 1; r < vals.length; r++) {
      if (String(vals[r][iIdx]).trim() === itemID) {
        syncFields.forEach(function(f) {
          var col = headers.indexOf(f);
          if (col >= 0 && data[f] !== undefined) sheet.getRange(r + 1, col + 1).setValue(data[f]);
        });
        // Qty badli to Pending Qty recalc (Produced Qty wahi rehta hai)
        var qCol  = headers.indexOf('Qty');
        var pqCol = headers.indexOf('Produced Qty');
        var pdCol = headers.indexOf('Pending Qty');
        if (qCol >= 0 && pdCol >= 0 && data['Qty'] !== undefined) {
          var newQty   = parseFloat(data['Qty']) || 0;
          var produced = pqCol >= 0 ? (parseFloat(vals[r][pqCol]) || 0) : 0;
          var pend     = newQty - produced;
          sheet.getRange(r + 1, pdCol + 1).setValue(pend < 0 ? 0 : pend);
        }
        break;
      }
    }
  }

  try { syncSheet(SpreadsheetApp.openById(PROD_ID).getSheetByName('Production')); } catch(e) { Logger.log('itemsync prod: ' + e); }
  try { syncSheet(SS_ACC().getSheetByName('Accounts')); } catch(e) { Logger.log('itemsync acc: ' + e); }
  try { syncSheet(SS_CRM().getSheetByName('CRM1')); } catch(e) { Logger.log('itemsync crm: ' + e); }
}

// =============================================
// SYNC: ORDER EDIT → Production + Accounts + CRM1 (Order ID match, saari rows)
// =============================================
function syncOrderToLinkedSheets(data) {
  var orderID = String(data['Order ID'] || '').trim();
  if (!orderID) return;

  // sheetField : orderField mapping
  var commonMap = {
    'Customer Name': 'Customer Name',
    'Sales Person':  'Sales Person Name',
    'Assigned CRM':  'Assigned CRM',
    'Order Date':    'Date'
  };
  var crmMap = {
    'Customer Name':      'Customer Name',
    'Customer No':        'Customer Phone',
    'Sales Person':       'Sales Person Name',
    'Payment Mode':       'Payment Mode',
    'Plan Payment Date':  'Plan Payment Date',
    'Payment Status':     'Payment Status',
    'Plan Dispatch Date': 'Plan Dispatch Date'
  };

  function syncSheet(sheet, map) {
    if (!sheet || sheet.getLastRow() <= 1) return;
    var vals    = sheet.getDataRange().getValues();
    var headers = vals[0].map(function(h) { return h.toString().trim(); });
    var oIdx    = headers.indexOf('Order ID');
    if (oIdx < 0) return;
    for (var r = 1; r < vals.length; r++) {
      if (String(vals[r][oIdx]).trim() === orderID) {
        Object.keys(map).forEach(function(sheetField) {
          var orderField = map[sheetField];
          if (data[orderField] === undefined) return;
          var col = headers.indexOf(sheetField);
          if (col < 0) return;
          var val = data[orderField];
          if (typeof val === 'string' && (val.indexOf('T') > -1 || /^\d{4}-\d{2}-\d{2}$/.test(val))) val = fixDateFormat(val);
          sheet.getRange(r + 1, col + 1).setValue(val);
        });
        // saari rows update karni hain — break NAHI
      }
    }
  }

  try { syncSheet(SpreadsheetApp.openById(PROD_ID).getSheetByName('Production'), commonMap); } catch(e) { Logger.log('ordersync prod: ' + e); }
  try { syncSheet(SS_ACC().getSheetByName('Accounts'), commonMap); } catch(e) { Logger.log('ordersync acc: ' + e); }
  try { syncSheet(SS_CRM().getSheetByName('CRM1'), crmMap); } catch(e) { Logger.log('ordersync crm: ' + e); }
}

// =============================================
// ONE-TIME BACKFILL — OrderItems se CRM1/Production/Accounts sync karo
// GAS editor se manually Run karo, deploy ki zaroorat nahi
// =============================================
function backfillItemSync() {
  var itemSheet = SS_SALES().getSheetByName('OrderItems');
  if (!itemSheet || itemSheet.getLastRow() <= 1) { Logger.log('No items'); return; }

  // 1. OrderItems ka master map banao
  var iVals = itemSheet.getDataRange().getValues();
  var iH    = iVals[0].map(function(h){ return h.toString().trim(); });
  var iI = iH.indexOf('Item ID'), iM = iH.indexOf('Product Model'),
      iB = iH.indexOf('Battery Type'), iQ = iH.indexOf('Qty');
  var master = {};
  for (var r = 1; r < iVals.length; r++) {
    var iid = String(iVals[r][iI]).trim();
    if (!iid) continue;
    master[iid] = {
      model: iVals[r][iM] || '',
      btype: iVals[r][iB] || '',
      qty:   parseFloat(iVals[r][iQ]) || 0
    };
  }

  var totalFixed = 0;

  function fixSheet(sheet, label) {
    if (!sheet || sheet.getLastRow() <= 1) return;
    var vals = sheet.getDataRange().getValues();
    var h    = vals[0].map(function(x){ return x.toString().trim(); });
    var cI = h.indexOf('Item ID'), cM = h.indexOf('Product Model'),
        cB = h.indexOf('Battery Type'), cQ = h.indexOf('Qty'),
        cPQ = h.indexOf('Produced Qty'), cPD = h.indexOf('Pending Qty');
    if (cI < 0) return;
    var fixed = 0;
    for (var r = 1; r < vals.length; r++) {
      var iid = String(vals[r][cI]).trim();
      var m = master[iid];
      if (!m) continue;
      var changed = false;
      if (cM >= 0 && String(vals[r][cM]) !== String(m.model)) { sheet.getRange(r+1, cM+1).setValue(m.model); changed = true; }
      if (cB >= 0 && String(vals[r][cB]) !== String(m.btype)) { sheet.getRange(r+1, cB+1).setValue(m.btype); changed = true; }
      if (cQ >= 0 && (parseFloat(vals[r][cQ])||0) !== m.qty)  {
        sheet.getRange(r+1, cQ+1).setValue(m.qty);
        changed = true;
        // Pending Qty recalc
        if (cPD >= 0) {
          var produced = cPQ >= 0 ? (parseFloat(vals[r][cPQ]) || 0) : 0;
          var pend = m.qty - produced;
          sheet.getRange(r+1, cPD+1).setValue(pend < 0 ? 0 : pend);
        }
      }
      if (changed) fixed++;
    }
    Logger.log(label + ': ' + fixed + ' rows fixed');
    totalFixed += fixed;
  }

  fixSheet(SS_CRM().getSheetByName('CRM1'), 'CRM1');
  fixSheet(SpreadsheetApp.openById(PROD_ID).getSheetByName('Production'), 'Production');
  fixSheet(SS_ACC().getSheetByName('Accounts'), 'Accounts');

  Logger.log('DONE — Total ' + totalFixed + ' rows corrected');
}

// =============================================
// ONE-TIME: Jo orders fully produced hain, unka Final Status set karo
// GAS editor se Run karo — deploy ki zaroorat nahi
// =============================================
function backfillOrderFinalStatus() {
  var pSheet = SpreadsheetApp.openById(PROD_ID).getSheetByName('Production');
  if (!pSheet || pSheet.getLastRow() <= 1) { Logger.log('No production rows'); return; }

  var pV = pSheet.getDataRange().getValues();
  var pH = pV[0].map(function(x){ return x.toString().trim(); });
  var oIdx = pH.indexOf('Order ID');
  var qIdx = pH.indexOf('Qty');
  var pqIdx= pH.indexOf('Produced Qty');

  // Order-wise total vs completed count
  var stat = {};
  for (var r = 1; r < pV.length; r++) {
    var oid = String(pV[r][oIdx] || '').trim();
    if (!oid) continue;
    if (!stat[oid]) stat[oid] = { total: 0, done: 0 };
    stat[oid].total++;
    var tq = parseFloat(pV[r][qIdx])  || 0;
    var pq = pqIdx >= 0 ? (parseFloat(pV[r][pqIdx]) || 0) : 0;
    if (tq > 0 && pq >= tq) stat[oid].done++;
  }

  // Orders sheet — Final Status
  var oSheet = SS_SALES().getSheetByName('Orders');
  var oV = oSheet.getDataRange().getValues();
  var oH = oV[0].map(function(x){ return x.toString().trim(); });
  var ordIdx = oH.indexOf('Order ID');
  var fsIdx  = oH.indexOf('Final Status');
  var fixed = 0;
  if (fsIdx >= 0) {
    for (var i = 1; i < oV.length; i++) {
      var oid2 = String(oV[i][ordIdx] || '').trim();
      var s = stat[oid2];
      if (!s || s.total === 0) continue;
      if (s.done === s.total && String(oV[i][fsIdx]).trim() !== 'Production Completed') {
        oSheet.getRange(i + 1, fsIdx + 1).setValue('Production Completed');
        fixed++;
      }
    }
  }

  // CRM1 — Current Stage
  try {
    var cSheet = SS_CRM().getSheetByName('CRM1');
    if (cSheet && cSheet.getLastRow() > 1) {
      var cV = cSheet.getDataRange().getValues();
      var cH = cV[0].map(function(x){ return x.toString().trim(); });
      var cOIdx = cH.indexOf('Order ID');
      var cSIdx = cH.indexOf('Current Stage');
      if (cSIdx >= 0) {
        for (var c = 1; c < cV.length; c++) {
          var oid3 = String(cV[c][cOIdx] || '').trim();
          var s3 = stat[oid3];
          if (s3 && s3.total > 0 && s3.done === s3.total) {
            cSheet.getRange(c + 1, cSIdx + 1).setValue('Production Complete');
          }
        }
      }
    }
  } catch(e) { Logger.log('CRM update error: ' + e); }

  Logger.log('DONE — ' + fixed + ' orders ka Final Status set hua');
}

