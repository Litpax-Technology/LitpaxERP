// =============================================
// UPDATE ORDER TOTAL VALUE WITH GST
// =============================================

function updateOrderTotalValue(orderID, extraChargerTotal) {
  try {
    var ss = SS_SALES();
    extraChargerTotal = parseFloat(extraChargerTotal) || 0;
    var itemSheet = ss.getSheetByName('OrderItems');
    if (!itemSheet) return;
    var iVals    = itemSheet.getDataRange().getValues();
    var iHeaders = iVals[0];
    var oIdx     = iHeaders.indexOf('Order ID');
    var tIdx     = iHeaders.indexOf('Total');
    var qIdx     = -1;
    for (var k = 0; k < iHeaders.length; k++) {
      if (iHeaders[k].toString().trim() === 'Qty') { qIdx = k; break; }
    }
    var totalWithGST = 0, totalQty = 0;
    for (var i = 1; i < iVals.length; i++) {
      if (iVals[i][oIdx] == orderID) {
        totalWithGST += (parseFloat(iVals[i][tIdx]) || 0) * 1.18;
        totalQty     += qIdx >= 0 ? (parseFloat(iVals[i][qIdx]) || 0) : 0;
      }
    }
    var chargerQty = 0;
    var chargerSheet = ss.getSheetByName('OrderItemCharger');
    if (chargerSheet && chargerSheet.getLastRow() > 1) {
      var cVals    = chargerSheet.getDataRange().getValues();
      var cHeaders = cVals[0];
      var cOIdx    = cHeaders.indexOf('Order ID');
      var cTIdx    = cHeaders.indexOf('Total');
      var cQIdx    = cHeaders.indexOf('Qty');
      for (var c = 1; c < cVals.length; c++) {
        if (cVals[c][cOIdx] == orderID) {
          totalWithGST += parseFloat(cVals[c][cTIdx]) || 0;
          chargerQty   += cQIdx >= 0 ? (parseFloat(cVals[c][cQIdx]) || 0) : 0;
        }
      }
    }
    totalWithGST += extraChargerTotal;
    var oSheet   = ss.getSheetByName('Orders');
    if (!oSheet) return;
    var oVals    = oSheet.getDataRange().getValues();
    var oHeaders = oVals[0];
    var ordIdx = -1, valIdx = -1, qtyIdx = -1, chrIdx = -1, transIdx = -1;
    for (var m = 0; m < oHeaders.length; m++) {
      var h = oHeaders[m].toString().trim();
      if (h === 'Order ID')               ordIdx   = m;
      if (h === 'Total Order Value')      valIdx   = m;
      if (h === 'Total Qty')              qtyIdx   = m;
      if (h === 'Charger Qty')            chrIdx   = m;
      if (h === 'Transportation Charges') transIdx = m;
    }
    for (var j = 1; j < oVals.length; j++) {
      if (oVals[j][ordIdx] == orderID) {
        var transCharge = transIdx >= 0 ? (parseFloat(oVals[j][transIdx]) || 0) : 0;
        var finalTotal  = Math.round(totalWithGST + transCharge);
        if (valIdx >= 0) oSheet.getRange(j + 1, valIdx + 1).setValue(finalTotal);
        if (qtyIdx >= 0) oSheet.getRange(j + 1, qtyIdx + 1).setValue(totalQty);
        if (chrIdx >= 0 && chargerQty > 0) oSheet.getRange(j + 1, chrIdx + 1).setValue(chargerQty);
        return finalTotal;
      }
    }
  } catch(e) {
    Logger.log('updateOrderTotalValue ERROR: ' + e.toString());
  }
}

