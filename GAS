      var key = h.toString().trim();
      return rowMap[key] !== undefined ? rowMap[key] : '';
    });
    sheet.appendRow(row);

    // CRM sheet — Billing Actual date update
    try {
      var crmSheet = SS_CRM().getSheetByName('CRM1');
      if (crmSheet) {
        var cVals    = crmSheet.getDataRange().getValues();
        var cHeaders = cVals[0];
        var cOIdx    = cHeaders.indexOf('Order ID');
        var cIIdx    = cHeaders.indexOf('Item ID');
        var cBAIdx   = cHeaders.indexOf('Billing Docs Actual');
        var cStIdx   = cHeaders.indexOf('Current Stage');
        for (var c = 1; c < cVals.length; c++) {
          var matchOrder = cVals[c][cOIdx] == data['Order ID'];
          var matchItem  = data['Item ID'] ? String(cVals[c][cIIdx]) === String(data['Item ID']) : true;
          if (matchOrder && matchItem) {
            if (cBAIdx >= 0) crmSheet.getRange(c + 1, cBAIdx + 1).setValue(date);
            if (cStIdx >= 0) crmSheet.getRange(c + 1, cStIdx + 1).setValue('Billed');
          }
        }
      }
    } catch(ce) { Logger.log('CRM billing update error: ' + ce); }

    // Accounts sheet — Billed Qty update
    try {
      var accSheet = SS_ACC().getSheetByName('Accounts');
      if (accSheet && accSheet.getLastRow() > 1) {
        // Total billed qty calculate karo is item ke liye
        var billedTotal = 0;
        var bVals = sheet.getDataRange().getValues();
        var bH    = bVals[0].map(function(h) { return h.toString().trim(); });
        var bOIdx = bH.indexOf('Order ID');
