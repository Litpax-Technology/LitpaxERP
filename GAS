function addPayment(data) {
  try {
    var ss    = SS_CRM();
    var sheet = ss.getSheetByName('Payments');
    if (!sheet) return { success: false, message: 'Payments tab not found' };
    var payID = 'PAY-' + new Date().getTime().toString().slice(-7);
    var now   = new Date();
    var date  = data['Date'] || (
      now.getDate().toString().padStart(2,'0') + '/' +
      (now.getMonth()+1).toString().padStart(2,'0') + '/' +
      now.getFullYear()
    );
    if (/^\d{4}-\d{2}-\d{2}/.test(date)) date = fixDateFormat(date);
    var row = [
      payID,
      data['Order ID']  || '',
      parseFloat(data['Amount']) || 0,
      date,
      data['Mode']      || '',
      data['Reference'] || '',
      data['Remarks']   || '',
      data['Added By']  || ''
    ];
    sheet.appendRow(row);

    // Accounts sheet update — Total Received aur Balance
    try {
      var orderID  = data['Order ID'] || '';
      var accSheet = SS_ACC().getSheetByName('Accounts');
      if (accSheet && orderID) {
        // Total received recalculate karo
        var allPays = getPayments({ 'Order ID': orderID });
        var totalReceived = allPays.totalReceived || 0;

        var aVals    = accSheet.getDataRange().getValues();
        var aHeaders = aVals[0].map(function(h) { return h.toString().trim(); });
        var aOIdx    = aHeaders.indexOf('Order ID');
        var aTRIdx   = aHeaders.indexOf('Total Received');
        var aBalIdx  = aHeaders.indexOf('Balance');
        var aOVIdx   = aHeaders.indexOf('Order Value');

        for (var ax = 1; ax < aVals.length; ax++) {
          if (String(aVals[ax][aOIdx]).trim() == String(orderID).trim()) {
            var orderVal = parseFloat(aVals[ax][aOVIdx]) || 0;
            if (aTRIdx >= 0) accSheet.getRange(ax + 1, aTRIdx + 1).setValue(totalReceived);
            if (aBalIdx >= 0) accSheet.getRange(ax + 1, aBalIdx + 1).setValue(orderVal - totalReceived);
          }
        }
      }
    } catch(ae) { Logger.log('Accounts payment update error: ' + ae); }

    return { success: true, payID: payID };
  } catch(e) {
    return { success: false, message: e.toString() };
  }
}

function getPayments(data) {
  try {
    var ss    = SS_CRM();
    var sheet = ss.getSheetByName('Payments');
    if (!sheet) return { success: true, data: [], totalReceived: 0 };
    var vals = sheet.getDataRange().getValues();
    if (vals.length <= 1) return { success: true, data: [], totalReceived: 0 };
    var headers = vals[0].map(function(h) { return h.toString().trim(); });
    var oIdx    = headers.indexOf('Order ID');
    var rows    = vals.slice(1)
      .filter(function(r) { return String(r[oIdx]).trim() == String(data['Order ID']).trim(); })
      .map(function(r) {
        var obj = {};
        headers.forEach(function(h, i) { obj[h] = r[i]; });
        return obj;
      });
    var totalReceived = rows.reduce(function(s, r) {
      return s + (parseFloat(r['Amount']) || 0);
    }, 0);
    return { success: true, data: rows, totalReceived: totalReceived };
  } catch(e) {
    return { success: false, message: e.toString() };
  }
}

function deletePayment(data) {
  try {
    var payID   = String(data['Payment ID'] || '').trim();
    var orderID = String(data['Order ID'] || '').trim();
    if (!payID) return { success: false, message: 'Payment ID missing' };

    var ss    = SS_CRM();
    var sheet = ss.getSheetByName('Payments');
    if (!sheet) return { success: false, message: 'Payments tab not found' };

    var vals    = sheet.getDataRange().getValues();
    var headers = vals[0].map(function(h) { return h.toString().trim(); });
    var idIdx   = headers.indexOf('Payment ID');
    if (idIdx < 0) return { success: false, message: 'Payment ID column not found' };

    var deleted = false;
    var rowOrderID = orderID;
    var oIdx = headers.indexOf('Order ID');
    for (var i = vals.length - 1; i >= 1; i--) {
      if (String(vals[i][idIdx]).trim() === payID) {
        if (!rowOrderID && oIdx >= 0) rowOrderID = String(vals[i][oIdx]).trim();
        sheet.deleteRow(i + 1);
        deleted = true;
      }
    }
    if (!deleted) return { success: false, message: 'Payment not found: ' + payID };

    // Accounts sheet — Total Received aur Balance recalc (addPayment jaisa)
    try {
      if (rowOrderID) {
        var accSheet = SS_ACC().getSheetByName('Accounts');
        if (accSheet) {
          var allPays = getPayments({ 'Order ID': rowOrderID });
          var totalReceived = allPays.totalReceived || 0;

          var aVals    = accSheet.getDataRange().getValues();
          var aHeaders = aVals[0].map(function(h) { return h.toString().trim(); });
          var aOIdx    = aHeaders.indexOf('Order ID');
          var aTRIdx   = aHeaders.indexOf('Total Received');
          var aBalIdx  = aHeaders.indexOf('Balance');
          var aOVIdx   = aHeaders.indexOf('Order Value');
          for (var ax = 1; ax < aVals.length; ax++) {
            if (String(aVals[ax][aOIdx]).trim() == String(rowOrderID).trim()) {
              var orderVal = parseFloat(aVals[ax][aOVIdx]) || 0;
              if (aTRIdx >= 0)  accSheet.getRange(ax + 1, aTRIdx + 1).setValue(totalReceived);
              if (aBalIdx >= 0) accSheet.getRange(ax + 1, aBalIdx + 1).setValue(orderVal - totalReceived);
            }
          }
        }
      }
    } catch(ae) { Logger.log('Accounts payment delete update error: ' + ae); }

    return { success: true, message: 'Payment deleted' };
  } catch(e) {
    return { success: false, message: e.toString() };
  }
}



