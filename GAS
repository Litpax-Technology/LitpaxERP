// =============================================
// DELETE ORDER ITEM (OrderItems + Production + Accounts + CRM se hatao)
// =============================================
function deleteOrderItem(data) {
  try {
    var itemID  = data['Item ID'] || '';
    var orderID = data['Order ID'] || '';
    if (!itemID) return { success: false, message: 'Item ID missing' };

    // 1) OrderItems se delete
    var ss    = SS_SALES();
    var sheet = ss.getSheetByName('OrderItems');
    if (!sheet) return { success: false, message: 'OrderItems tab not found' };
    var all     = sheet.getDataRange().getValues();
    var idIdx   = all[0].indexOf('Item ID');
    var deleted = false;
    for (var i = all.length - 1; i >= 1; i--) {
      if (String(all[i][idIdx]) === String(itemID)) { sheet.deleteRow(i + 1); deleted = true; }
    }
    if (!deleted) return { success: false, message: 'Item not found: ' + itemID };

    // 2) Production se delete
    try {
      var pSheet = SpreadsheetApp.openById(PROD_ID).getSheetByName('Production');
      if (pSheet && pSheet.getLastRow() > 1) {
        var pV = pSheet.getDataRange().getValues();
        var pI = pV[0].indexOf('Item ID');
        for (var p = pV.length - 1; p >= 1; p--) {
          if (String(pV[p][pI]) === String(itemID)) pSheet.deleteRow(p + 1);
        }
      }
    } catch(pe) { Logger.log('del prod item error: ' + pe); }

    // 3) Accounts se delete
    try {
      var aSheet = SS_ACC().getSheetByName('Accounts');
      if (aSheet && aSheet.getLastRow() > 1) {
        var aV = aSheet.getDataRange().getValues();
        var aI = aV[0].indexOf('Item ID');
        for (var a = aV.length - 1; a >= 1; a--) {
          if (String(aV[a][aI]) === String(itemID)) aSheet.deleteRow(a + 1);
        }
      }
    } catch(ae) { Logger.log('del acc item error: ' + ae); }

    // 4) CRM se delete
    try {
      var cSheet = SpreadsheetApp.openById(CRM_ID).getSheetByName('CRM1');
      if (cSheet && cSheet.getLastRow() > 1) {
        var cV = cSheet.getDataRange().getValues();
        var cI = cV[0].indexOf('Item ID');
        for (var c = cV.length - 1; c >= 1; c--) {
          if (String(cV[c][cI]) === String(itemID)) cSheet.deleteRow(c + 1);
        }
      }
    } catch(ce) { Logger.log('del crm item error: ' + ce); }

    // 5) Order total recalc
    if (orderID) updateOrderTotalValue(orderID);

    return { success: true, message: 'Item deleted' };
  } catch(e) {
    return { success: false, message: e.toString() };
  }
}



