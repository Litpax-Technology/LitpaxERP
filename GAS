function fixDateFormat(val) {
  if (!val || typeof val !== 'string') return val;
  if (/^\d{2}\/\d{2}\/\d{4}$/.test(val)) return val;
  if (val.indexOf('T') > -1 || /^\d{4}-\d{2}-\d{2}$/.test(val)) {
    var d = new Date(val);
    if (!isNaN(d.getTime())) {
      var ist = new Date(d.getTime() + (5.5 * 60 * 60 * 1000));
      return ist.getUTCDate().toString().padStart(2,'0') + '/' +
             (ist.getUTCMonth()+1).toString().padStart(2,'0') + '/' +
             ist.getUTCFullYear();
    }
  }
  return val;
}

function doGet(e)  { return handleRequest(e); }
function doPost(e) {
  try { return handleRequest(e); }
  catch(err) {
    return ContentService.createTextOutput(JSON.stringify({ success: false, message: err.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

function handleRequest(e) {
  const cb = e && e.parameter && e.parameter.callback;
  let result;
  try {
    const params   = e && e.parameter ? e.parameter : {};
    const postData = e && e.postData ? JSON.parse(e.postData.contents || '{}') : {};
    const rawData  = Object.assign({}, params, postData);
    const data = {};
    Object.keys(rawData).forEach(function(k) {
      data[k.replace(/\+/g, ' ')] = rawData[k];
    });
    const action = data.action;
    switch (action) {
      case 'login':                result = login(data); break;
      case 'getOrders':            result = getSheet('Orders',         SS_SALES); break;
      case 'addOrder':             result = addOrder(data); break;
      case 'updateOrder':          result = updateByID('Orders', 'Order ID', SS_SALES, data); if (result.success && data['Transportation Charges'] !== undefined) updateOrderTotalValue(data['Order ID']); if (result.success) syncOrderToLinkedSheets(data); break;
      case 'getOrderItems':        result = getSheet('OrderItems',     SS_SALES); break;
      case 'getItemsByOrder':      result = getItemsByOrder(data); break;
      case 'addOrderItem':         result = addOrderItem(data); break;
      case 'updateOrderItem':      result = updateByID('OrderItems', 'Item ID', SS_SALES, data); if (result.success) syncItemToLinkedSheets(data); break;
      case 'deleteOrderItem':      result = deleteOrderItem(data); break;
      case 'updateProdItems':      result = updateProdItems(data); break;
      case 'getCRM':               result = getSheet('CRM1',          SS_CRM);  break;
      case 'updateCRM':            result = updateCRM(data); break;
      case 'getProduction':        result = getSheet('Production',    SS_PROD); break;
      case 'updateProduction':     result = updateProduction(data); break;
      case 'markFMSProductionDone': result = markFMSProductionDone(data); break;
      case 'getAccounts':          result = getSheet('Accounts',      SS_ACC); break;
      case 'getUsers':             result = getSheet('Users',         SS_SALES); break;
      case 'addUser':              result = addToSheet('Users',       SS_SALES, data); break;
      case 'getCustomers':         result = getSheet('Customers',     SS_SALES); break;
      case 'addCustomer':          result = addCustomer(data); break;
      case 'updateCustomer':       result = updateCustomer(data); break;
      case 'getProducts':          result = getSheet('Products',      SS_SALES); break;
      case 'addProduct':           result = addToSheet('Products',    SS_SALES, data); break;
      case 'getSuppliers':         result = getSheet('Suppliers',     SS_SALES); break;
      case 'addSupplier':          result = addToSheet('Suppliers',   SS_SALES, data); break;
      case 'updateChargerInOrder': result = updateChargerInOrder(data); break;
      case 'addChargerItem':       result = addChargerItem(data); break;
      case 'getChargersByOrder':   result = getChargersByOrder(data); break;
      case 'updateChargerItem':    result = updateChargerItem(data); break;
      case 'deleteChargerItem':    result = deleteChargerItem(data); break;
      case 'deleteOrder':           result = deleteOrder(data); break;
      case 'uploadCustomerDoc':    result = uploadCustomerDoc(data); break;
      case 'getCustomerDocs':      result = getCustomerDocs(data); break;
      case 'getCustFolderId':      result = { success: true, folderId: getCustFolderId() }; break;
      case 'uploadSlip':           result = uploadSlip(data); break;
      case 'getUploadUrl':         result = getUploadUrl(data); break;
      case 'getAccessToken':       result = { success: true, token: ScriptApp.getOAuthToken() }; break;
      case 'getSlips':             result = getSlips(data); break;
      case 'addPayment':           result = addPayment(data); break;
      case 'getPayments':          result = getPayments(data); break;
      case 'getAllPayments':       result = getAllPayments(); break;
      case 'deletePayment':        result = deletePayment(data); break;
      case 'getAccountsBundle':    result = getAccountsBundle(); break;
      case 'getDispatchBundle':    result = getDispatchBundle(); break;
      case 'getProductionBundle':  result = getProductionBundle(); break;
      case 'getCRMBundle':         result = getCRMBundle(); break;
      case 'addBilling':           result = addBilling(data); break;
      case 'getBillings':          result = getBillings(data); break;
      case 'getAllBillings':        result = getAllBillings(); break;
      case 'addDispatch':           result = addDispatch(data); break;
      case 'getAllDispatches':      result = getAllDispatches(); break;
      case 'addPlannedProduction':  result = addPlannedProduction(data); break;
      case 'getPlannedProduction':  result = getPlannedProduction(); break;
      case 'getBatterySpec':        result = getBatterySpec(data); break;
      case 'saveBatterySpec':       result = saveBatterySpec(data); break;
      case 'setBatterySpecColumns': result = setBatterySpecColumns(data); break;
      default: result = { success: false, message: 'Unknown action: ' + action };
    }
  } catch(err) {
    result = { success: false, message: err.toString() };
  }
  const out = ContentService.createTextOutput(
    cb ? cb + '(' + JSON.stringify(result) + ')' : JSON.stringify(result)
  );
  out.setMimeType(cb ? ContentService.MimeType.JAVASCRIPT : ContentService.MimeType.JSON);
  return out;
}

