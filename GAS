// AUTO-SAVE CUSTOMER FROM ORDER (duplicate check ke sath)
// =============================================

function autoSaveCustomerFromOrder(orderData) {
  try {
    var custName = (orderData['Customer Name'] || '').trim();
    if (!custName) return;

    var ss    = SS_SALES();
    var sheet = ss.getSheetByName('Customers');
    if (!sheet) return;

    var vals    = sheet.getDataRange().getValues();
    var headers = vals[0];
    var nameIdx  = headers.indexOf('CompanyName');
    var phoneIdx = headers.indexOf('Phone');
    if (nameIdx === -1) return;

    var newPhone = String(orderData['Customer Phone'] || '').trim();

    // Duplicate check — Name (case-insensitive) YA Phone match ho to skip
    for (var i = 1; i < vals.length; i++) {
      var existName  = String(vals[i][nameIdx] || '').trim().toLowerCase();
      var existPhone = phoneIdx >= 0 ? String(vals[i][phoneIdx] || '').trim() : '';
      if (existName === custName.toLowerCase()) return;               // naam same → skip
      if (newPhone && existPhone && existPhone === newPhone) return;  // phone same → skip
    }

    // Naya customer add karo
    var lastRow = sheet.getLastRow();
    var custID  = 'C' + String(lastRow).padStart(3, '0');
    var custData = {
      'CustomerID':    custID,
      'CompanyName':   custName,
      'ContactPerson': custName,
      'Phone':         newPhone,
      'GSTIN':         '',
      'City':          orderData['City'] || '',
      'CreditDays':    '',
      'Added By':      orderData['Sales Person Name'] || ''
    };
    var row = headers.map(function(h) {
      var key = h.toString().trim();
      return custData[key] !== undefined ? custData[key] : '';
    });
    sheet.appendRow(row);
  } catch(e) {
    Logger.log('autoSaveCustomerFromOrder ERROR: ' + e.toString());
  }
}

// =============================================
// ORDER ITEM CHARGER
// =============================================

function addChargerItem(data) {
  try {
    var ss    = SS_SALES();
    var sheet = ss.getSheetByName('OrderItemCharger');
    if (!sheet) return { success: false, message: 'OrderItemCharger tab not found' };
    var chargerID = 'CHR-' + new Date().getTime().toString().slice(-7);
    data['Charger ID'] = chargerID;
    var now = new Date();
    data['Date'] = now.getDate().toString().padStart(2,'0') + '/' +
                   (now.getMonth()+1).toString().padStart(2,'0') + '/' +
                   now.getFullYear();
    var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    var row     = headers.map(function(h) { return data[h] !== undefined ? data[h] : ''; });
    sheet.appendRow(row);

    var orderID      = data['Order ID'] || '';
    var chargerTotal = parseFloat(data['Total']) || 0;
    var chargerQty   = parseFloat(data['Qty']) || 0;

    if (orderID && chargerTotal > 0) {
      var oSheet   = ss.getSheetByName('Orders');
      var oVals    = oSheet.getDataRange().getValues();
      var oHeaders = oVals[0];
      var ordIdx = -1, valIdx = -1, chrIdx = -1;
      for (var m = 0; m < oHeaders.length; m++) {
        var h = oHeaders[m].toString().trim();
        if (h === 'Order ID')          ordIdx = m;
        if (h === 'Total Order Value') valIdx = m;
        if (h === 'Charger Qty')       chrIdx = m;
      }
      for (var r = 1; r < oVals.length; r++) {
        if (oVals[r][ordIdx] == orderID) {
          var currentTotal = parseFloat(oVals[r][valIdx]) || 0;
          if (valIdx >= 0) oSheet.getRange(r + 1, valIdx + 1).setValue(Math.round(currentTotal + chargerTotal));
          if (chrIdx >= 0) oSheet.getRange(r + 1, chrIdx + 1).setValue(chargerQty);
          break;
        }
      }
    }

    var allModels = [];
    var cSheet2 = ss.getSheetByName('OrderItemCharger');
    if (cSheet2 && cSheet2.getLastRow() > 1) {
      var cV2 = cSheet2.getDataRange().getValues();
      var cH2 = cV2[0];
      var cO2 = cH2.indexOf('Order ID');
      var cM2 = cH2.indexOf('Charger Model');
      var cQ2 = cH2.indexOf('Qty');
      var totalCQty = 0;
      for (var cx = 1; cx < cV2.length; cx++) {
        if (cV2[cx][cO2] == orderID) {
          totalCQty += parseFloat(cV2[cx][cQ2]) || 0;
          var m2 = cM2 >= 0 ? (cV2[cx][cM2] || '') : '';
          if (m2 && allModels.indexOf(m2) === -1) allModels.push(m2);
        }
      }
      chargerQty = totalCQty;
    }
    var modelStr = allModels.join(', ');

    if (orderID && chargerQty > 0) {
      try {
        var pss    = SpreadsheetApp.openById(PROD_ID);
        var pSheet = pss.getSheetByName('Production');
        if (pSheet && pSheet.getLastRow() > 1) {
          var pVals    = pSheet.getDataRange().getValues();
          var pHeaders = pVals[0];
          var pOIdx    = pHeaders.indexOf('Order ID');
          var pCIdx    = pHeaders.indexOf('Charger Qty');
          var pMIdx    = pHeaders.indexOf('Charger Model');
          for (var p = 1; p < pVals.length; p++) {
            if (pVals[p][pOIdx] == orderID) {
              if (pCIdx >= 0) pSheet.getRange(p + 1, pCIdx + 1).setValue(chargerQty);
              if (pMIdx >= 0) pSheet.getRange(p + 1, pMIdx + 1).setValue(modelStr);
              break;
            }
          }
        }
      } catch(pe) { Logger.log('Production charger update error: ' + pe); }
    }

    if (orderID && chargerQty > 0) {
      try {
        var accSheet = SS_ACC().getSheetByName('Accounts');
        if (accSheet && accSheet.getLastRow() > 1) {
          var aVals    = accSheet.getDataRange().getValues();
          var aHeaders = aVals[0];
          var aOIdx    = aHeaders.indexOf('Order ID');
          var aCIdx    = aHeaders.indexOf('Charger Qty');
          var aMIdx    = aHeaders.indexOf('Charger Model');
          for (var a = 1; a < aVals.length; a++) {
            if (aVals[a][aOIdx] == orderID) {
              if (aCIdx >= 0) accSheet.getRange(a + 1, aCIdx + 1).setValue(chargerQty);
              if (aMIdx >= 0) accSheet.getRange(a + 1, aMIdx + 1).setValue(modelStr);
            }
          }
        }
      } catch(ae) { Logger.log('Accounts charger update error: ' + ae); }
    }

    return { success: true, chargerID: chargerID };
  } catch(e) {
    return { success: false, message: e.toString() };
  }
}

