function backfillAccounts() {
  var salesSS = SS_SALES();
  var crmSS   = SS_CRM();
  var accSS   = SS_ACC();

  var itemSheet = salesSS.getSheetByName('OrderItems');
  var accSheet  = accSS.getSheetByName('Accounts');
  var ordSheet  = salesSS.getSheetByName('Orders');
  var paySheet  = crmSS.getSheetByName('Payments');

  if (!itemSheet || !accSheet || !ordSheet) { Logger.log('Sheet not found'); return; }

  // Clear existing data (keep headers)
  if (accSheet.getLastRow() > 1) {
    accSheet.getRange(2, 1, accSheet.getLastRow() - 1, accSheet.getLastColumn()).clearContent();
  }

  // Orders map
  var oVals = ordSheet.getDataRange().getValues();
  var oH    = oVals[0];
  var orderMap = {};
  for (var i = 1; i < oVals.length; i++) {
    var obj = {};
    oH.forEach(function(h, j) { obj[h] = oVals[i][j]; });
    orderMap[obj['Order ID']] = obj;
  }

  // Payments map — total received per order
  var payMap = {};
  if (paySheet && paySheet.getLastRow() > 1) {
    var pVals = paySheet.getDataRange().getValues();
    var pH    = pVals[0].map(function(h) { return h.toString().trim(); });
    var pOIdx = pH.indexOf('Order ID');
    var pAIdx = pH.indexOf('Amount');
    for (var p = 1; p < pVals.length; p++) {
      var oid = String(pVals[p][pOIdx]).trim();
      if (!payMap[oid]) payMap[oid] = 0;
      payMap[oid] += parseFloat(pVals[p][pAIdx]) || 0;
    }
  }

  // Production map — item ID se produced/pending qty
  var prodSheet = SpreadsheetApp.openById(PROD_ID).getSheetByName('Production');
  var prodMap   = {};
  if (prodSheet && prodSheet.getLastRow() > 1) {
    var prVals = prodSheet.getDataRange().getValues();
    var prH    = prVals[0];
    var prIIdx = prH.indexOf('Item ID');
    var prPIdx = prH.indexOf('Produced Qty');
    var prNIdx = prH.indexOf('Pending Qty');
    for (var pr = 1; pr < prVals.length; pr++) {
      var iid = String(prVals[pr][prIIdx]).trim();
      prodMap[iid] = {
        producedQty: parseFloat(prVals[pr][prPIdx]) || 0,
        pendingQty:  parseFloat(prVals[pr][prNIdx]) || 0
      };
    }
  }

  // Items
  var iVals = itemSheet.getDataRange().getValues();
  var iH    = iVals[0];
  var headers = accSheet.getRange(1, 1, 1, accSheet.getLastColumn()).getValues()[0];

  var count = 0;
  for (var r = 1; r < iVals.length; r++) {
    var item = {};
    iH.forEach(function(h, j) { item[h] = iVals[r][j]; });
    var order       = orderMap[item['Order ID']] || {};
    var orderVal    = parseFloat(order['Total Order Value']) || 0;
    var received    = payMap[item['Order ID']] || 0;
    var balance     = orderVal - received;
    var prodData    = prodMap[item['Item ID']] || {};
    var producedQty = prodData.producedQty || 0;
    var pendingQty  = prodData.pendingQty  || (parseFloat(item['Qty']) || 0);

    var accData = {};
    headers.forEach(function(h) { accData[h.toString().trim()] = ''; });
    accData['Sr No']          = r;
    accData['Item ID']        = item['Item ID'] || '';
    accData['Order ID']       = item['Order ID'] || '';
    accData['Order Date']     = order['Date'] || '';
    accData['Customer Name']  = order['Customer Name'] || '';
    accData['Product Model']  = item['Product Model'] || '';
    accData['Battery Type']   = item['Battery Type'] || '';
    accData['Qty']            = item['Qty'] || '';
    accData['Charger Model']  = order['Charger Model'] || '';
    accData['Charger Qty']    = order['Charger Qty'] || '';
    accData['Sales Person']   = order['Sales Person Name'] || '';
    accData['Assigned CRM']   = order['Assigned CRM'] || '';
    accData['Order Value']    = orderVal;
    accData['Total Received'] = received;
    accData['Balance']        = balance;
    accData['Produced Qty']   = producedQty;
    accData['Pending Qty']    = pendingQty;

    var row = headers.map(function(h) { return accData[h.toString().trim()] !== undefined ? accData[h.toString().trim()] : ''; });
    accSheet.appendRow(row);
    count++;
  }
  Logger.log('Done — ' + count + ' rows added');
}

