function getSheet(tabName, ssFn) {
  const ss    = ssFn();
  const sheet = ss.getSheetByName(tabName);
  if (!sheet) return { success: false, message: tabName + ' tab not found' };
  const vals  = sheet.getDataRange().getValues();
  if (vals.length <= 1) return { success: true, data: [] };
  const headers = vals[0];
  const rows    = vals.slice(1).map(row => {
    const obj = {};
    headers.forEach((h, i) => { obj[h] = row[i]; });
    return obj;
  });
  return { success: true, data: rows };
}

function addToSheet(tabName, ssFn, data) {
  const ss    = ssFn();
  const sheet = ss.getSheetByName(tabName);
  if (!sheet) return { success: false, message: tabName + ' tab not found' };
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  const row     = headers.map(h => data[h] !== undefined ? data[h] : '');
  sheet.appendRow(row);
  return { success: true, message: 'Added to ' + tabName };
}

function updateByID(tabName, idCol, ssFn, data) {
  const ss    = ssFn();
  const sheet = ss.getSheetByName(tabName);
  if (!sheet) return { success: false, message: tabName + ' tab not found' };
  const all     = sheet.getDataRange().getValues();
  const headers = all[0];
  const idIdx   = headers.indexOf(idCol);
  const idVal   = data[idCol];
  for (let i = 1; i < all.length; i++) {
    if (all[i][idIdx] == idVal) {
      headers.forEach((h, j) => {
        if (data[h] !== undefined) {
          var val = data[h];
          if (typeof val === 'string' && (val.indexOf('T') > -1 || /^\d{4}-\d{2}-\d{2}$/.test(val))) {
            val = fixDateFormat(val);
          }
          sheet.getRange(i + 1, j + 1).setValue(val);
        }
      });
      return { success: true, message: tabName + ' updated' };
    }
  }
  return { success: false, message: 'Row not found: ' + idVal };
}

