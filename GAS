// =============================================
// UPDATE PRODUCTION
// =============================================

function updateProduction(data) {
  try {
    var ss    = SpreadsheetApp.openById(PROD_ID);
    var sheet = ss.getSheetByName('Production');
    if (!sheet) return { success: false, message: 'Production sheet not found' };
    var all     = sheet.getDataRange().getValues();
    var headers = all[0];
    var itemIdx = headers.indexOf('Item ID');
    var oIdx    = headers.indexOf('Order ID');
    var itemID  = data['Item ID'] || '';
    var orderID = data['Order ID'] || '';
    var targetRow = -1;
    if (itemID && itemIdx >= 0) {
      for (var i = 1; i < all.length; i++) {
        if (String(all[i][itemIdx]) === String(itemID)) { targetRow = i; break; }
      }
    }
    if (targetRow === -1) {
      for (var j = 1; j < all.length; j++) {
        if (all[j][oIdx] == orderID) { targetRow = j; break; }
      }
    }
    if (targetRow === -1) return { success: false, message: 'Row not found' };
    headers.forEach(function(h, k) {
      if (data[h] !== undefined) {
        var val = data[h];
        if (typeof val === 'string' && (val.indexOf('T') > -1 || /^\d{4}-\d{2}-\d{2}$/.test(val))) {
          val = fixDateFormat(val);
        }
        sheet.getRange(targetRow + 1, k + 1).setValue(val);
      }
    });

    // Produced Qty aur Pending Qty update karo
    var producedQty = parseFloat(data['Produced Qty']) || 0;
    if (producedQty > 0) {
      var totalQtyIdx = headers.indexOf('Qty');
      var prodQtyIdx  = headers.indexOf('Produced Qty');
      var pendQtyIdx  = headers.indexOf('Pending Qty');
      var totalQty    = parseFloat(all[targetRow][totalQtyIdx]) || 0;
      var pendingQty  = totalQty - producedQty;
      if (prodQtyIdx >= 0) sheet.getRange(targetRow + 1, prodQtyIdx + 1).setValue(producedQty);
      if (pendQtyIdx >= 0) sheet.getRange(targetRow + 1, pendQtyIdx + 1).setValue(pendingQty < 0 ? 0 : pendingQty);

      // Accounts sheet bhi update karo
      try {
        var accSheet = SS_ACC().getSheetByName('Accounts');
        if (accSheet && accSheet.getLastRow() > 1) {
          var aVals    = accSheet.getDataRange().getValues();
          var aHeaders = aVals[0].map(function(h) { return h.toString().trim(); });
          var aIIdx    = aHeaders.indexOf('Item ID');
          var aPQIdx   = aHeaders.indexOf('Produced Qty');
          var aPdIdx   = aHeaders.indexOf('Pending Qty');
          for (var ax = 1; ax < aVals.length; ax++) {
            if (String(aVals[ax][aIIdx]).trim() === String(itemID).trim()) {
              if (aPQIdx >= 0) accSheet.getRange(ax + 1, aPQIdx + 1).setValue(producedQty);
              if (aPdIdx >= 0) accSheet.getRange(ax + 1, aPdIdx + 1).setValue(pendingQty < 0 ? 0 : pendingQty);
              break;
            }
          }
        }
      } catch(ae) { Logger.log('Accounts produced qty update error: ' + ae); }
    }

    // OrderItems sheet mein bhi status update karo
    if (itemID) {
      try {
        var salesSS  = SS_SALES();
        var oiSheet  = salesSS.getSheetByName('OrderItems');
        if (oiSheet && oiSheet.getLastRow() > 1) {
          var oiVals    = oiSheet.getDataRange().getValues();
          var oiHeaders = oiVals[0];
          var oiIIdx    = oiHeaders.indexOf('Item ID');
          var oiStIdx   = oiHeaders.indexOf('Status');
          if (oiStIdx >= 0) {
            for (var oi = 1; oi < oiVals.length; oi++) {
              if (String(oiVals[oi][oiIIdx]).trim() === String(itemID).trim()) {
                var prodStatus = data['Status'] || '';
                var actualComplete = data['Production Complete Actual'] || '';
                var actualStart    = data['Production Start Actual'] || '';
                var itemStatus = prodStatus === 'Completed' || actualComplete
                  ? 'Production Completed'
                  : actualStart
                  ? 'In Progress'
                  : 'Pending';
                oiSheet.getRange(oi + 1, oiStIdx + 1).setValue(itemStatus);
                break;
              }
            }
          }
        }
      } catch(oie) { Logger.log('OrderItems status update error: ' + oie); }
    }

    var result = { success: true, message: 'Production updated' };
    if (!orderID) return result;

    var vals2    = sheet.getDataRange().getValues();
    var headers2 = vals2[0];
    var oIdx2    = headers2.indexOf('Order ID');
    var qIdx2    = headers2.indexOf('Qty');
    var pqIdx2   = headers2.indexOf('Produced Qty');
    var totalRows = 0, completedRows = 0;
    for (var r = 1; r < vals2.length; r++) {
      if (vals2[r][oIdx2] == orderID) {
        totalRows++;
        var tq = parseFloat(vals2[r][qIdx2])  || 0;
        var pq = parseFloat(vals2[r][pqIdx2]) || 0;
        if (tq > 0 && pq >= tq) completedRows++;
      }
    }
    if (totalRows > 0 && totalRows === completedRows) {
      var salesSS = SS_SALES();
      var oSheet  = salesSS.getSheetByName('Orders');
      if (oSheet) {
        var oVals    = oSheet.getDataRange().getValues();
        var oHeaders = oVals[0];
        var ordIdx   = oHeaders.indexOf('Order ID');
        var fsIdx    = oHeaders.indexOf('Final Status');
        if (fsIdx >= 0) {
          for (var f = 1; f < oVals.length; f++) {
            if (oVals[f][ordIdx] == orderID) {
              oSheet.getRange(f + 1, fsIdx + 1).setValue('Production Completed');
              break;
            }
          }
        }
      }
      var crmSS    = SpreadsheetApp.openById(CRM_ID);
      var crmSheet = crmSS.getSheetByName('CRM1');
      if (crmSheet) {
        var cVals    = crmSheet.getDataRange().getValues();
        var cHeaders = cVals[0];
        var cOIdx    = cHeaders.indexOf('Order ID');
        var cSIdx    = cHeaders.indexOf('Current Stage');
        if (cSIdx >= 0) {
          for (var cr = 1; cr < cVals.length; cr++) {
            if (cVals[cr][cOIdx] == orderID) {
              crmSheet.getRange(cr + 1, cSIdx + 1).setValue('Production Complete');
            }
          }
        }
      }
      result.allCompleted = true;
    }
    return result;
  } catch(e) {
    return { success: false, message: e.toString() };
  }
}

