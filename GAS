function getOrderByID(orderID) {
  var ss    = SS_SALES();
  var sheet = ss.getSheetByName('Orders');
  if (!sheet) return {};
  var vals    = sheet.getDataRange().getValues();
  var headers = vals[0];
  var oIdx    = headers.indexOf('Order ID');
  for (var i = 1; i < vals.length; i++) {
    if (vals[i][oIdx] == orderID) {
      var obj = {};
      headers.forEach(function(h, j) { obj[h] = vals[i][j]; });
      return obj;
    }
  }
  return {};
}

// =============================================
// PUSH ITEM TO PRODUCTION
// =============================================

function pushItemToProduction(orderData, itemData) {
  try {
    var ss    = SpreadsheetApp.openById(PROD_ID);
    var sheet = ss.getSheetByName('Production');
    if (!sheet) return;
    var lastRow = sheet.getLastRow();
    var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    if (!headers || headers.length === 0) return;
    var prodData = {};
    for (var i = 0; i < headers.length; i++) prodData[headers[i]] = '';

    var chargerQty = ''; var chargerModel = '';
    try {
      var ssSales = SS_SALES();
      var orderID = orderData['Order ID'] || itemData['Order ID'] || '';
      var existingRows = 0;
      var pVals2  = sheet.getDataRange().getValues();
      var pH2     = pVals2[0];
      var pO2     = pH2.indexOf('Order ID');
      for (var ex = 1; ex < pVals2.length; ex++) {
        if (pVals2[ex][pO2] == orderID) existingRows++;
      }
      if (existingRows === 0) {
        var cSheet = ssSales.getSheetByName('OrderItemCharger');
        if (cSheet && cSheet.getLastRow() > 1) {
          var cVals    = cSheet.getDataRange().getValues();
          var cHeaders = cVals[0];
          var cOIdx    = cHeaders.indexOf('Order ID');
          var cQIdx    = cHeaders.indexOf('Qty');
          var cMIdx    = cHeaders.indexOf('Charger Model');
          var totalCQty = 0; var chargerModels = [];
          for (var c = 1; c < cVals.length; c++) {
            if (cVals[c][cOIdx] == orderID) {
              totalCQty += parseFloat(cVals[c][cQIdx]) || 0;
              var cm = cMIdx >= 0 ? (cVals[c][cMIdx] || '') : '';
              if (cm && chargerModels.indexOf(cm) === -1) chargerModels.push(cm);
            }
          }
          if (totalCQty > 0) chargerQty = totalCQty;
          chargerModel = chargerModels.join(', ');
        }
      }
    } catch(ce) { Logger.log('chargerQty fetch error: ' + ce); }

    prodData['Sr No']         = lastRow;
    prodData['Item ID']       = itemData['Item ID'] || '';
    prodData['Order ID']      = orderData['Order ID'] || itemData['Order ID'] || '';
    prodData['Order Date']    = orderData['Date'] || '';
    prodData['Customer Name'] = orderData['Customer Name'] || '';
    prodData['Product Model'] = itemData['Product Model'] || '';
    prodData['Battery Type']  = itemData['Battery Type']  || '';
    prodData['Qty']           = itemData['Qty'] || '';
    prodData['Charger Model'] = chargerModel || '';
    prodData['Charger Qty']   = chargerQty || '';
    prodData['Sales Person']  = orderData['Sales Person Name'] || '';
    prodData['Assigned CRM']  = orderData['Assigned CRM'] || '';
    prodData['Sales Remarks'] = itemData['Remarks'] || '';
    prodData['Status']        = 'Pending';
    prodData['Remarks']       = '';
    var row = headers.map(function(h) { return prodData[h] !== undefined ? prodData[h] : ''; });
    sheet.appendRow(row);
  } catch(e) {
    Logger.log('pushItemToProduction ERROR: ' + e.toString());
  }
}

