// BATTERY SPEC (customer-wise, sheet-driven columns)
// Sales spreadsheet me "BatterySpec" tab. Header row hi column definition hai.
// Naya column chahiye? Sheet me "Customer Name" ke baad, "Updated By" se pehle header add karo.
// =============================================

var BATTERY_SPEC_SHEET = 'BatterySpec';

function getBatterySpecSheet_() {
  var ss = SS_SALES();
  var sh = ss.getSheetByName(BATTERY_SPEC_SHEET);
  if (!sh) {
    sh = ss.insertSheet(BATTERY_SPEC_SHEET);
    // Sirf pehli baar ka default header — baad me sheet me hi columns add/rename/hata sakte ho
    sh.appendRow(['Customer Name','Battery Model','Sticker','BMS','Cell','Connector','Remarks','Updated By','Updated At']);
    sh.setFrozenRows(1);
  }
  return sh;
}

// Header se dynamic columns nikaalo — meta columns chhod ke baaki sab spec columns
function getSpecColumns_(header) {
  var meta = ['Customer Name','Updated By','Updated At'];
  return header.filter(function(h) { return h && meta.indexOf(h) === -1; });
}

function getBatterySpec(data) {
  try {
    var sh = getBatterySpecSheet_();
    var cust = (data['customerName'] || '').toString().trim().toLowerCase();
    var values = sh.getDataRange().getValues();
    var header = values.length ? values[0] : [];
    var cols = getSpecColumns_(header);
    var out = [];
    for (var i = 1; i < values.length; i++) {
      if ((values[i][0] || '').toString().trim().toLowerCase() !== cust) continue;
      var obj = {};
      cols.forEach(function(c) {
        var idx = header.indexOf(c);
        obj[c] = idx > -1 ? values[i][idx] : '';
      });
      out.push(obj);
    }
    return { success: true, columns: cols, data: out };
  } catch(e) {
    return { success: false, message: e.toString() };
  }
}

function saveBatterySpec(data) {
  try {
    var sh = getBatterySpecSheet_();
    var cust = (data['customerName'] || '').toString().trim();
    if (!cust) return { success: false, message: 'Customer name missing' };
    var rows = [];
    try { rows = JSON.parse(data['rows'] || '[]'); } catch (e) { return { success: false, message: 'Bad rows data' }; }

    var header = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
    var values = sh.getDataRange().getValues();

    // is customer ki purani rows hatao (neeche se upar)
    for (var i = values.length - 1; i >= 1; i--) {
      if ((values[i][0] || '').toString().trim().toLowerCase() === cust.toLowerCase()) sh.deleteRow(i + 1);
    }

    // nayi rows append
    var now = new Date(), addedBy = data['Added By'] || '';
    rows.forEach(function(r) {
      var line = header.map(function(h) {
        if (h === 'Customer Name') return cust;
        if (h === 'Updated By')    return addedBy;
        if (h === 'Updated At')    return now;
        return r[h] != null ? r[h] : '';
      });
      sh.appendRow(line);
    });
    return { success: true, count: rows.length };
  } catch(e) {
    return { success: false, message: e.toString() };
  }
}

// Column headers set karo — rename/add/delete sab. Data preserve hota hai:
// jo columns naam same rehta hai uska data as-is; naya column khaali; hataya column ka data gayab.
function setBatterySpecColumns(data) {
  try {
    var sh = getBatterySpecSheet_();
    var newCols = [];
    try { newCols = JSON.parse(data['columns'] || '[]'); } catch (e) { return { success: false, message: 'Bad columns data' }; }
    newCols = newCols.filter(function(c) { return c && c.toString().trim(); }).map(function(c) { return c.toString().trim(); });
    if (!newCols.length) return { success: false, message: 'At least one column required' };

    var values = sh.getDataRange().getValues();
    var oldHeader = values.length ? values[0] : [];
    var oldCols   = getSpecColumns_(oldHeader);   // purane spec columns (meta chhod ke)

    // Naya poora header banao: Customer Name + newCols + Updated By + Updated At
    var finalHeader = ['Customer Name'].concat(newCols).concat(['Updated By','Updated At']);

    // Purani data rows ko naye header ke hisaab se remap karo (naam se match)
    var remapped = [];
    for (var i = 1; i < values.length; i++) {
      var row = values[i];
      var obj = {};
      oldHeader.forEach(function(h, j) { obj[h] = row[j]; });
      var line = finalHeader.map(function(h) {
        // Position-based rename ke liye: agar newCol purane spec-col ki jagah pe hai to purana data uthao
        if (h === 'Customer Name' || h === 'Updated By' || h === 'Updated At') return obj[h] != null ? obj[h] : '';
        // Naam same mila? seedha uthao
        if (obj[h] !== undefined) return obj[h];
        // Rename case: newCols me is position ka purana col dhundo
        var pos = newCols.indexOf(h);
        if (pos > -1 && oldCols[pos] !== undefined && obj[oldCols[pos]] !== undefined) return obj[oldCols[pos]];
        return '';
      });
      remapped.push(line);
    }

    // Sheet clear karke naya header + remapped data likho
    sh.clear();
    sh.getRange(1, 1, 1, finalHeader.length).setValues([finalHeader]).setFontWeight('bold');
    sh.setFrozenRows(1);
    if (remapped.length) sh.getRange(2, 1, remapped.length, finalHeader.length).setValues(remapped);

    return { success: true, columns: newCols };
  } catch(e) {
    return { success: false, message: e.toString() };
  }
}

