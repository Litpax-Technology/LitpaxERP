function updateChargerInOrder(data) {
  try {
    var orderID      = data['Order ID'] || '';
    var chargerQty   = parseFloat(data['Charger Qty']) || 0;
    var chargerTotal = parseFloat(data['Charger Total']) || 0;
    var ss     = SS_SALES();
    var oSheet = ss.getSheetByName('Orders');
    if (!oSheet) return { success: false, message: 'Orders sheet not found' };
    var oVals    = oSheet.getDataRange().getValues();
    var oHeaders = oVals[0];
    var ordIdx = -1, chrIdx = -1, valIdx = -1, transIdx = -1;
    for (var m = 0; m < oHeaders.length; m++) {
      var h = oHeaders[m].toString().trim();
      if (h === 'Order ID')               ordIdx   = m;
      if (h === 'Charger Qty')            chrIdx   = m;
      if (h === 'Total Order Value')      valIdx   = m;
      if (h === 'Transportation Charges') transIdx = m;
    }
    for (var j = 1; j < oVals.length; j++) {
      if (oVals[j][ordIdx] == orderID) {
        if (chrIdx >= 0) oSheet.getRange(j + 1, chrIdx + 1).setValue(chargerQty);
        var itemSheet = ss.getSheetByName('OrderItems');
        var iVals     = itemSheet.getDataRange().getValues();
        var iHeaders  = iVals[0];
        var iOIdx     = iHeaders.indexOf('Order ID');
        var iTIdx     = iHeaders.indexOf('Total');
        var batteryTotal = 0;
        for (var i = 1; i < iVals.length; i++) {
          if (iVals[i][iOIdx] == orderID) batteryTotal += parseFloat(iVals[i][iTIdx]) || 0;
        }
        var transCharge = transIdx >= 0 ? (parseFloat(oVals[j][transIdx]) || 0) : 0;
        var totalOrderValue = Math.round(batteryTotal * 1.18 + chargerTotal + transCharge);
        if (valIdx >= 0) oSheet.getRange(j + 1, valIdx + 1).setValue(totalOrderValue);
        return { success: true, message: 'Charger updated' };
      }
    }
    return { success: false, message: 'Order not found' };
  } catch(e) {
    return { success: false, message: e.toString() };
  }
}

